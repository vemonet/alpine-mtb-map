        <mwm:value key="open_from">01-01</mwm:value>
        <mwm:value key="closed_from">01-01</mwm:value>
      </mwm:properties>
      <mwm:icon>Mountain</mwm:icon><mwm:visibility>1</mwm:visibility>
    </ExtendedData>

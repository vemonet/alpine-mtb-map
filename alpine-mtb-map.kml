        <mwm:value key="closed_from">01-01</mwm:value>
      </mwm:properties>
      <mwm:icon>Mountain</mwm:icon><mwm:visibility>1</mwm:visibility>
    </ExtendedData>
  </Placemark>
  <Placemark>
    <name>Jonkershoek: Valley Trail</name>
    <description><![CDATA[2.0 km blue trail, dropping 47 m from 332 m to 285 m at an average 2%. A near-flat link along the valley floor, the easiest line in the network. Geometry drawn in gpx.studio and supplied for this map, simplified to approximately 8 m - indicative only; follow the signs on the ground and ride with a valid permit.]]></description>

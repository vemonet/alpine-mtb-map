  <Placemark>
    <name>Chalmazel: top of the Jasseries chairlift</name>
    <description><![CDATA[Top of the Jasseries chairlift at 1456 m, under the 1634 m Pierre-sur-Haute summit - the start of the gravity runs back to the station.]]></description>
    <styleUrl>#placemark-gray</styleUrl>
    <Point><coordinates>3.813140,45.661730,1456</coordinates></Point>

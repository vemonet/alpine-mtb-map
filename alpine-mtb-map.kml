      <mwm:visibility>1</mwm:visibility>
    </ExtendedData>
  </Placemark>
  <Placemark>
    <name>Andermatt: Gemsstock</name>
    <description><![CDATA[The high cable car, 2961 m. Bike carriage is not a given up here - ask before you queue.]]></description>
    <styleUrl>#placemark-gray</styleUrl>
    <Point><coordinates>8.611604,46.602310,2932</coordinates></Point>

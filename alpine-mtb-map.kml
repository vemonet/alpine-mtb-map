    <ExtendedData xmlns:mwm="https://comaps.app"><mwm:properties><mwm:value key="spot">cuyuna</mwm:value><mwm:value key="tags">beginner intermediate expert natural no-lift enduro freeride rain-sensitive</mwm:value><mwm:value key="open_from">05-01</mwm:value><mwm:value key="closed_from">11-01</mwm:value><mwm:value key="price_day">7 USD</mwm:value><mwm:value key="price_season">35 USD</mwm:value></mwm:properties><mwm:icon>Sport</mwm:icon><mwm:visibility>1</mwm:visibility></ExtendedData>

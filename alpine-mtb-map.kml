        <mwm:value key="spot">arosa</mwm:value>
        <mwm:value key="tags">beginner expert bike-park dh enduro gondola</mwm:value>
        <mwm:value key="open_from">06-15</mwm:value>
        <mwm:value key="closed_from">10-26</mwm:value>
        <mwm:value key="price_day">53 CHF</mwm:value>
      </mwm:properties>
      <mwm:icon>Mountain</mwm:icon>
      <mwm:visibility>1</mwm:visibility>
    </ExtendedData>
  </Placemark>

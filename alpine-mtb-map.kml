    <ExtendedData xmlns:mwm="https://comaps.app"><mwm:properties><mwm:value key="spot">tsali-recreation-area</mwm:value><mwm:value key="tags">beginner intermediate natural no-lift enduro</mwm:value><mwm:value key="price_day">2 USD</mwm:value></mwm:properties><mwm:icon>Sport</mwm:icon><mwm:visibility>1</mwm:visibility></ExtendedData>

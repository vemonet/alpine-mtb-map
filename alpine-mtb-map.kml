        <mwm:value key="tags">beginner expert natural no-lift enduro</mwm:value>
      </mwm:properties>
      <mwm:icon>Mountain</mwm:icon>
      <mwm:visibility>1</mwm:visibility>
    </ExtendedData>
  </Placemark>

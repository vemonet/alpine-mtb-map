    <ExtendedData xmlns:mwm="https://comaps.app"><mwm:properties><mwm:value key="spot">cady-hill-forest</mwm:value><mwm:value key="tags">beginner intermediate expert natural no-lift enduro freeride</mwm:value><mwm:value key="open_from">05-25</mwm:value><mwm:value key="closed_from">11-01</mwm:value></mwm:properties><mwm:icon>Sport</mwm:icon><mwm:visibility>1</mwm:visibility></ExtendedData>

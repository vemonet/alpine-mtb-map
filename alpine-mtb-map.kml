    </ExtendedData>
  </Placemark>
  <Placemark>
    <name>Anzère: top of the Pas-de-Maimbre gondola</name>
    <description><![CDATA[<b>Pas-de-Maimbré 2362 m - top of the Anzère gondola</b><br/><br/>
    Top station of the Pas-de-Maimbre gondola, where the descents start. See the main Anzère pin for trails, prices and access.]]></description>
    <styleUrl>#placemark-gray</styleUrl>
    <Point><coordinates>7.385609,46.314928,2363</coordinates></Point>
    <ExtendedData xmlns:mwm="https://comaps.app"><mwm:properties><mwm:value key="spot">anzere</mwm:value></mwm:properties><mwm:icon>None</mwm:icon><mwm:visibility>1</mwm:visibility></ExtendedData>

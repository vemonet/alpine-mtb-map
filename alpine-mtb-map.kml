        <mwm:value key="open_from">05-01</mwm:value>
        <mwm:value key="closed_from">11-01</mwm:value>
        <mwm:value key="price_day">70 CHF</mwm:value>
      </mwm:properties>
      <mwm:icon>Mountain</mwm:icon>
      <mwm:visibility>1</mwm:visibility>
    </ExtendedData>
  </Placemark>

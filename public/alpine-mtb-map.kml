      <Data name="open_from"><value>06-01</value></Data><Data name="closed_from"><value>11-01</value></Data>
      <mwm:icon>Mountain</mwm:icon><mwm:visibility>1</mwm:visibility>
    </ExtendedData>
  </Placemark>
  <Placemark>
    <name>Lafur / Mazandaran Forest MTB (IR) [guided, no lift]</name>
    <description><![CDATA[<b>Lafur Forest - Hyrcanian forest adventure riding</b><br/><br/><b>Trails</b><br/>Dense beech forest, loamy village tracks, steep mountain roads and wet roots offer a green contrast to Iran's dry southern Alborz. There is no signed trail centre, and forest protection, land access and navigation require local knowledge.<br/><br/><b>Getting up / price</b><br/>No lift. Arrange a guide and vehicle support from Mazandaran; use only permitted roads and tracks.<br/><br/><b>Open season</b><br/>Best from April-June and September-November. Avoid saturated trails, snow and peak summer humidity.<br/><br/><b>Access</b><table class="access"><tr><th>From</th><th>Transport</th><th>Duration</th></tr><tr><td>Tehran</td><td>Car</td><td>~4h</td></tr></table><br/><i>Source: <a href="https://visitiran.ir/en/attraction/Lafur--Forest">Visit Iran: Lafur Forest</a>. This is a regional adventure pin, not a marked MTB park.</i>]]></description>
    <styleUrl>#placemark-brown</styleUrl>
    <Point><coordinates>52.9300,36.2600,0</coordinates></Point>

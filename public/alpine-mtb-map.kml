      <mwm:icon>Mountain</mwm:icon><mwm:visibility>1</mwm:visibility>
    </ExtendedData>
  </Placemark>
  <Placemark>
    <name>Koko Head Bike Park (Oahu, US) [no lift, free]</name>
    <description><![CDATA[<b>Honolulu's public dirt-jump and pump-track park</b><br/><br/><b>Trails</b><br/>Volunteer-built progressive dirt jumps, pump tracks and skills lines range from strider and family terrain to large expert jumps. This is a session park, not a downhill trail network.<br/><br/><b>Getting up / price</b><br/>Free pedal access; no lift. Pedal bikes only; e-bikes and motorized vehicles are not permitted on the bike-park features.<br/><br/><b>Open season</b><br/>Open year-round, subject to maintenance and wet-ground closures. <br/>Daily opening hours: 07:00-22:00<br/><small>District-park hours estimate; ride in daylight and check HBL Dirt for closures.</small><br/><br/><b>Access</b><table class="access"><tr><th>From</th><th>Transport</th><th>Duration</th></tr><tr><td>Waikiki</td><td>Car</td><td>~25 min</td></tr><tr><td>Honolulu</td><td>Bus + bike</td><td>~1h</td></tr></table><br/><i>Source: <a href="https://www.hbldirt.org/khbp/">HBL Dirt - Koko Head Bike Park</a>. Respect volunteer closures and posted line directions.</i>]]></description>
    <styleUrl>#placemark-brown</styleUrl>
    <Point><coordinates>-157.7107,21.2828,0</coordinates></Point>

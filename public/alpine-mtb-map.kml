      <mwm:visibility>1</mwm:visibility>
    </ExtendedData>
  </Placemark>
  <Placemark>
    <name>Arosa: Weisshorn 2653 m</name>
    <description><![CDATA[Top of the Weisshornbahn, the high point above the village and the start of the long alpine descents.]]></description>
    <styleUrl>#placemark-gray</styleUrl>
    <Point><coordinates>9.639157,46.789284,0</coordinates></Point>
    <ExtendedData xmlns:mwm="https://omaps.app">
      <Data name="spot"><value>arosa</value></Data>

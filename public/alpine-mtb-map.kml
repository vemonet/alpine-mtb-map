  <Placemark>
    <name>St-Luc Bike Park / Tignousa (Val d'Anniviers) [29 CHF]</name>
    <description><![CDATA[St-Luc station at 1684 m, base of the bike-carrying funicular to Tignousa.]]></description>
    <styleUrl>#placemark-blue</styleUrl>
    <Point><coordinates>7.602517,46.219634,1682</coordinates></Point>

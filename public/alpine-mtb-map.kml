  <Placemark>
    <name>Bikepark Spicak (Sumava, CZ) [940 CZK]</name>
    <description><![CDATA[Zelezna Ruda valley station of the Spicak chairlift, 866 m - ticket office, bike wash and the finish of most lines.]]></description>
    <styleUrl>#placemark-blue</styleUrl>
    <Point><coordinates>13.221500,49.165210,866</coordinates></Point>

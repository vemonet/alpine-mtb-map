      <mwm:visibility>1</mwm:visibility>
    </ExtendedData>
  </Placemark>
  <Placemark>
    <name>Grindelwald: Bort</name>
    <description><![CDATA[Mid station. The short Bort-to-village descent is the easy option if the full 1100 m looks like too much.]]></description>
    <styleUrl>#placemark-gray</styleUrl>
    <Point><coordinates>8.051765,46.646756,0</coordinates></Point>

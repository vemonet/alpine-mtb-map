  <Placemark>
    <name>Villard: top of the Cote 2000 gondola</name>
    <description><![CDATA[The gondola takes three bikes and riders per cabin, so expect a queue on a hot Sunday in August.]]></description>
    <styleUrl>#placemark-gray</styleUrl>
    <Point><coordinates>5.569300,45.029800,1719</coordinates></Point>

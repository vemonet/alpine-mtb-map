  <Placemark>
    <name>Mystic Bike Park - Bright (Victoria, AU) [100 AUD]</name>
    <description><![CDATA[Mystic Park trailhead at 330 m on the edge of Bright - shuttle pick-up, parking and the end of every descent.]]></description>
    <styleUrl>#placemark-blue</styleUrl>

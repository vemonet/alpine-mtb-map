    <ExtendedData xmlns:mwm="https://omaps.app"><Data name="spot"><value>jahorina</value></Data><Data name="tags"><value>expert bike-park dh enduro</value></Data><Data name="open_from"><value>06-15</value></Data><Data name="closed_from"><value>09-15</value></Data><mwm:icon>Mountain</mwm:icon><mwm:visibility>1</mwm:visibility></ExtendedData>

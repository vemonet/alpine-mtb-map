  <Placemark>
    <name>Crans-Montana: Les Violettes / Les Barzettes</name>
    <description><![CDATA[Second lift access on the Montana side, useful for reaching the Plaine Morte end of the domain and the longer natural descents back to the valley.]]></description>
    <styleUrl>#placemark-gray</styleUrl>
    <Point><coordinates>7.498832,46.320660,1515</coordinates></Point>
    <ExtendedData xmlns:mwm="https://omaps.app">
      <Data name="spot"><value>cransmontana</value></Data>

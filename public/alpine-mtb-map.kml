,0 7.406387,46.299537,0 7.405666,46.298777,0 7.405584,46.299511,0 7.405194,46.299256,0 7.404941,46.299984,0 7.405621,46.300067,0 7.406173,46.301168,0 7.406846,46.301767,0 7.410245,46.302999,0 7.411009,46.304017,0 7.410941,46.304267,0 7.410535,46.304229,0 7.408079,46.302959,0 7.406064,46.302837,0 7.405942,46.302590,0 7.405208,46.302349,0 7.404527,46.301558,0 7.402775,46.300774,0 7.401964,46.299979,0 7.401600,46.298795,0 7.401008,46.298507,0 7.401010,46.297947,0 7.400039,46.296480,0 7.398829,46.296468,0 7.397425,46.296099,0 7.396617,46.296216,0</coordinates></LineString>

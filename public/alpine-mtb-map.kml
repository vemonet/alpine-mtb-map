  <Placemark>
    <name>Monte Tremezzo (Lake Como) [no lift]</name>
    <description><![CDATA[<b>Monte Tremezzo MTB route</b><br/><br/>A long natural mountain-bike route on the western shore of Lake Como, linking the high slopes above Menaggio and Porlezza with broad lake and mountain views. This is a pedal-accessed enduro/XC route, not a lift-served bike park.<br/><br/><i>Source: <a href="https://www.openstreetmap.org/relation/12662560">OpenStreetMap relation 12662560</a> (ODbL) and <a href="https://www.visitcomo.eu/">Visit Como</a>. Check local access, hiking traffic and trail conditions.</i>]]></description>
    <styleUrl>#placemark-green</styleUrl>
    <Point><coordinates>9.126114,45.958198,938</coordinates></Point>
    <ExtendedData xmlns:mwm="https://omaps.app"><Data name="spot"><value>monte-tremezzo</value></Data><Data name="tags"><value>expert natural no-lift enduro</value></Data><mwm:icon>Mountain</mwm:icon><mwm:visibility>1</mwm:visibility></ExtendedData>
  </Placemark>
  <Placemark>
    <name>Monte Tremezzo MTB route</name>
    <description><![CDATA[<b>12.8 km natural MTB route</b><br/><br/>Long mountain-bike line across the Monte Tremezzo area above Lake Como. It includes forest paths, rough mountain tracks and exposed sections; ride only where cycling is permitted and yield to hikers.<br/><br/><i>Geometry simplified from <a href="https://www.openstreetmap.org/relation/12662560">OpenStreetMap relation 12662560</a> (ODbL). Indicative line; confirm the current route and local restrictions before riding.</i>]]></description>
